        <div className="hero">
          <div className="carousel">
            {slides.map((s, i) => (
              <div key={i} className={`carousel-slide ${s.class}`} style={{ display: i === slide ? "flex" : "none" }}>
                <div className="slide-circle" />
                <div className="slide-content">
                  <span className="offer-tag">{s.tag}</span>
                  <h2>{s.h2}</h2>
                  <p>{s.p}</p>
                  <button className="slide-btn">{s.btn} →</button>
                </div>
                <div className="slide-img">{s.emoji}</div>
              </div>
            ))}
          </div>
          <div className="dots">
            {slides.map((_, i) => <div key={i} className={`dot ${i === slide ? "active" : ""}`} />)}
          </div>
        </div>

        {/* SOCIAL PROOF */}
        <div className="social-proof">
          <div className="avatars">
            {["स", "प", "र", "म"].map((a, i) => <div key={i} className="avatar">{a}</div>)}
          </div>
          <p>मागच्या 1 तासात <strong>247 महिलांनी</strong> खरेदी केली! तुम्हीही आत्ताच ऑर्डर करा 🎉</p>
        </div>

        {/* FREE DELIVERY PROGRESS */}
        <div className="delivery-progress">
          <div className="dp-header">
            <span>🚚 Free Delivery प्रगती</span>
            <span className="dp-amount">₹{cartTotal} / ₹299</span>
          </div>
          <div className="progress-bar">
            <div className="progress-fill" style={{ width: `${progress}%` }} />
          </div>
          {remaining > 0
            ? <p className="dp-hint">आणखी ₹{remaining} ची खरेदी करा आणि फ्री डिलिव्हरी मिळवा! 🎁</p>
            : <p className="dp-hint" style={{ color: "#2e7d32", fontWeight: 700 }}>🎉 अभिनंदन! तुम्हाला Free Delivery मिळाली!</p>
          }
        </div>

        {/* CATEGORIES */}
        <div className="section">
          <div className="section-header">
            <h3>श्रेणी <span>निवडा</span></h3>
            <span className="see-all">सर्व पहा</span>
          </div>
          <div className="cats-scroll">
            {categories.map((c, i) => (
              <div key={i} className={`cat-chip ${activeCat === i ? "active" : ""}`} onClick={() => setActiveCat(i)}>
                <span className="cat-emoji">{c.emoji}</span>
                <span className="cat-name">{c.name}</span>
              </div>
            ))}
          </div>
        </div>

        {/* RECIPE SUGGESTION */}
        <div className="section">
          <div className="recipe-card">
            <div className="recipe-header">
              <div className="recipe-icon">🍛</div>
              <div>
                <h4>आजच्या जेवणासाठी — पुलाव?</h4>
                <p>AI ने तुमच्यासाठी सुचवले • 7 वस्तू लागतील</p>
              </div>
            </div>
            <div className="recipe-items">
              {["बासमती तांदूळ", "हिरवे वाटाणे", "तूप", "मसाला", "कांदे", "टोमॅटो", "धणे"].map((item, i) => (
                <span key={i} className="recipe-item">{item}</span>
              ))}
            </div>
            <button className="recipe-btn">🛒 सर्व वस्तू कार्टमध्ये टाका — ₹180 मध्ये</button>
          </div>
        </div>

        {/* HOT DEALS */}
        <div className="section">
          <div className="section-header">
            <h3>🔥 <span>आजचे Combo</span> डील्स</h3>
            <span className="see-all">सर्व पहा</span>
          </div>
          <div className="deals-scroll">
            {[
              { emoji: "🥛🧈", name: "ब्रेकफास्ट कॉम्बो", combo: "दूध + बटर + ब्रेड", price: "₹95", save: "₹35 वाचले", cls: "deal-d1" },
              { emoji: "🌾🫙", name: "स्वयंपाक कॉम्बो", combo: "आटा + तेल", price: "₹340", save: "₹50 वाचले", cls: "deal-d2" },
              { emoji: "🧴💄", name: "ब्युटी कॉम्बो", combo: "क्रीम + फेसवॉश", price: "₹199", save: "₹80 वाचले", cls: "deal-d3" },
              { emoji: "🧹🫧", name: "क्लीनिंग किट", combo: "डिटर्जंट + फिनाइल", price: "₹155", save: "₹45 वाचले", cls: "deal-d1" },
            ].map((d, i) => (
              <div key={i} className="deal-card">
                <div className={`deal-img ${d.cls}`}>{d.emoji}</div>
                <div className="deal-info">
                  <div className="deal-name">{d.name}</div>
                  <div className="deal-combo">{d.combo}</div>
                  <div className="deal-price-row">
                    <span className="deal-price">{d.price}</span>
                    <span className="deal-save">{d.save}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* PRODUCTS */}
        <div className="section">
          <div className="section-header">
            <h3>⭐ <span>बेस्टसेलर</span> वस्तू</h3>
            <span className="see-all">सर्व पहा</span>
          </div>
          <div className="products-grid">
            {products.map(p => (
              <div key={p.id} className="product-card">
                <div className={`product-img ${p.bg}`}>
                  <span>{p.emoji}</span>
                  <span className="discount-badge">{p.discount} OFF</span>
                  {p.best && <span className="bestseller-badge">⭐ Best</span>}
                </div>
                <div className="product-info">
                  <div className="product-name">{p.name}</div>
                  <div className="product-weight">{p.weight}</div>
                  {p.viewers && (
                    <div className="viewers-tag">
                      👁️ {p.viewers} जण आत्ता पाहत आहेत
                    </div>
                  )}
                  <div className="product-bottom">
                    <div className="prices">
                      <span className="current-price">₹{p.price}</span>
                      <span className="old-price">₹{p.mrp}</span>
                    </div>
                    {cart[p.id] ? (
                      <div className="qty-ctrl">
                        <button className="qty-btn" onClick={() => removeFromCart(p.id)}>−</button>
                        <span className="qty-num">{cart[p.id]}</span>
                        <button className="qty-btn" onClick={() => addToCart(p.id)}>+</button>
                      </div>
                    ) : (
                      <button className="add-btn" onClick={() => addToCart(p.id)}>+</button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* RECENTLY VIEWED */}
        <div className="section">
          <div className="section-header">
            <h3>👀 <span>नुकतेच</span> पाहिलेले</h3>
          </div>
          <div className="recent-scroll">
            {[
              { emoji: "🫙", name: "सरसों तेल", price: "₹165" },
              { emoji: "🍫", name: "Bournvita", price: "₹220" },
              { emoji: "🧴", name: "Fair & Lovely", price: "₹85" },
              { emoji: "🥚", name: "अंडी 12 पीस", price: "₹72" },
              { emoji: "🍵", name: "ताज चहा", price: "₹95" },
              { emoji: "🧹", name: "Vim बार", price: "₹35" },
            ].map((r, i) => (
              <div key={i} className="recent-card">
                <span className="r-emoji">{r.emoji}</span>
                <span className="r-name">{r.name}</span>
                <span className="r-price">{r.price}</span>
              </div>
            ))}
          </div>
        </div>

        {/* LOYALTY */}
        <div className="section" style={{ marginBottom: 16 }}>
          <div className="loyalty-card">
            <div className="loyalty-icon">👑</div>
            <div className="loyalty-info">
              <h4>किराणा मॉल पॉइंट्स</h4>
              <p>खरेदी करा, पॉइंट्स मिळवा, सूट घ्या!</p>
              <div className="loyalty-points">
                <span className="points-val">₹50</span>
                <span className="points-label">पर्यंत रिवॉर्ड्स उपलब्ध</span>
              </div>
            </div>
          </div>
        </div>

        {/* CART NUDGE */}
        {showNudge && (
          <div className="cart-nudge">
            <span>🎁 आणखी ₹{remaining} ची खरेदी करा → Free Delivery!</span>
            <button className="nudge-btn">पहा →</button>
          </div>
        )}

        {/* BOTTOM NAV */}
        <div className="bottom-nav">
          {[
            { icon: "🏠", label: "होम", active: true },
            { icon: "🔍", label: "शोधा" },
            { icon: "💖", label: "आवडते" },
            { icon: "🛒", label: `कार्ट ${cartCount > 0 ? `(${cartCount})` : ""}` },
            { icon: "👤", label: "अकाउंट" },
          ].map((n, i) => (
            <div key={i} className={`nav-item ${n.active ? "active" : ""}`}>
              <span className="nav-icon">{n.icon}</span>
              <span className="nav-label">{n.label}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  );
}
